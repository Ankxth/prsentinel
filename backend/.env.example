# Copy this file to .env (same folder) and fill in what you need.
# .env is ignored by git and must never be committed.

# development or production
APP_ENV=development

# Where the dashboard runs. Browsers may call the API only from this address.
FRONTEND_ORIGIN=http://localhost:5173

# Not needed yet. Filled in as the features that use them are built.
# Postgres connection string. Needed for migrations and anything using the database.
# Supabase: Connect > Direct > Connection Method: Session pooler > URI.
# (The Direct string is IPv6-only by default and often fails on home networks.)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=
