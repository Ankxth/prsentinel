# Copy this file to .env (same folder) and fill in what you need.
# .env is ignored by git and must never be committed.

# development or production
APP_ENV=development

# Where the dashboard runs. Browsers may call the API only from this address.
FRONTEND_ORIGIN=http://localhost:5173

# Not needed yet. Filled in as the features that use them are built.
# Postgres connection string. Needed for migrations and anything using the database.
# Supabase: Connect > Direct > Connection Method: Session pooler > URI.
# (The Direct string is IPv6-only by default and often fails on home networks.)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Optional. The SECRET key from Supabase (API Keys page). Server only, never in the frontend.
# Lets "delete my account" also remove the Supabase login record.
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# AI file summaries (feature C) use their own Groq key so they cannot use up the quota above.
# Without it summaries are simply switched off. Never share or commit it.
GROQ_API_KEY_SUMMARIES=

# Signs the short-lived pass the Action gets for one run. Required for runs to work.
# Make one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a different value in production than on your computer.
RUN_TOKEN_SECRET=

# Optional tuning (defaults shown)
# GITHUB_OIDC_AUDIENCE=prsentinel
# RUN_TOKEN_TTL_SECONDS=3600
# MAX_FUNCTIONS_PER_RUN=50
# MAX_REPOS_PER_USER=5

# Context map limits (feature C). Optional; these are the defaults.
# MAX_CONTEXT_FILES=500
# MAX_CONTEXT_BATCH_FILES=100
# MAX_CONTEXT_UPLOAD_BYTES=2000000

# AI model settings (defaults shown)
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MODEL_SUMMARIES=llama-3.1-8b-instant
# LLM_TIMEOUT_SECONDS=20
