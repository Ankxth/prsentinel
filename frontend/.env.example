# Copy to .env.local. Only VITE_ values are visible to the browser, so never put secrets here.
# The publishable key (older name: anon key) is meant for the browser. Never use the secret key here.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Address shown in the workflow snippet (your deployed server). Optional.
# VITE_PUBLIC_API_URL=https://prsentinel-21ho.onrender.com
